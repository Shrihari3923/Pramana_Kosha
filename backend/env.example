DATABASE_URL=postgres://youruser@localhost:5432/pramana_kosha
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3000
OCR_SERVICE_URL=http://127.0.0.1:8000/ocr

# Required for Ed25519 private-key encryption in development mode.
# Generate with: openssl rand -hex 32
# If unset, document signing will fail with "NOT_CONFIGURED".
KEY_ENCRYPTION_SECRET=change-me-to-another-long-random-string-32-chars

# Comma-separated list of allowed CORS origins.
# Add your frontend URL here. Do NOT use wildcard (*) in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
