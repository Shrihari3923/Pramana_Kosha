  "query": "SELECT u.id as \"id!: uuid::Uuid\",\n                  u.email as \"email!: String\",\n                  u.role as \"role!: crate::models::Role\"\n           FROM users u\n           JOIN case_assignments ca ON ca.user_id = u.id\n           WHERE ca.case_id = $1\n           ORDER BY u.email",
